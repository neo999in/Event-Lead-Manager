# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# caches & temp files
.chrome-temp*
.chrome*
*.log

# root-level temporary audit screenshots & scripts
/audit_*.png
/verify_*.png
/dashboard_*.png
/shot.png
/capture_audit_screens.mjs
/verify_screens.mjs
/create_api.py
/migrate.py
/test_*.mjs
/reset_db.js
*.db
*.db-journal
